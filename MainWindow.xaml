<Window x:Class="SoundOff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoundOff"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800" Background="#FF704949" >

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <Border BorderThickness="3" CornerRadius="3" Margin="10,10,10,5" BorderBrush="Black" Grid.Row="0" >
                <local:Oscillator x:Name="oscillator1" Margin="0">

                </local:Oscillator>
            </Border>
            <Border BorderThickness="3" CornerRadius="3" Margin="10,5,10,5" BorderBrush="Black" Grid.Row="1">
                <local:Oscillator x:Name="oscillator2" Margin="0" >

                </local:Oscillator>
            </Border>
            <Border BorderThickness="3" CornerRadius="3" Margin="10,5,10,10" BorderBrush="Black" Grid.Row="2">
                <local:Oscillator x:Name="oscillator3" Margin="0">

                </local:Oscillator>
            </Border>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <local:Visualizer x:Name="Graph"></local:Visualizer>
            <local:ADSRSliders x:Name="ASDREnvelope" Margin="0,0,10,0" Grid.Row="1"/>


        </Grid>
    </Grid>
